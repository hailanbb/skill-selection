{
  "name": "tv-season-linux",
  "version": "1.3.0",
  "private": true,
  "description": "剧集整理Linux版：SSH中文菜单、远端API、持久四阶段工作流",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "bin": { "tvflow": "bin/tvflow.js" },
  "scripts": {
    "build": "node scripts/build-cores.cjs",
    "test": "node --test test/*.test.js",
    "test:upstream": "node --test vendor/upstream/test/*.test.cjs",
    "start": "node bin/tvflow.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.0",
    "@grpc/proto-loader": "0.8.0",
    "@xmldom/xmldom": "0.9.12",
    "xlsx-js-style": "1.2.0"
  }
}
