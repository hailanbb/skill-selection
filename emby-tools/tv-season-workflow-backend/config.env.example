# Copy to config.env and populate locally. Never commit the populated file.
CD_ORIGIN=https://your-clouddrive.example:8920
CD_TOKEN=
CD_TRANSPORT=grpc-web
MP_ORIGIN=https://your-moviepilot.example:8920
MP_TOKEN=
MP_AUTH_MODE=apikey
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN
# CloudDrive virtual paths, identical on Windows and Ubuntu (NOT OS mount paths).
SOURCE_ROOT=/115/Library_incs/nas/电视剧
ARCHIVE_ROOT=/115/Library_incs/nas.finish/电视剧
# Optional: paths inside MoviePilot's own local filesystem/container.
MP_REPAIR_SOURCE=/downloads
MP_REPAIR_TARGET=/media
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
BACKEND_API_KEY=
ALLOW_REMOTE_WRITES=false
